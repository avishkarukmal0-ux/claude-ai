NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/vendora-dev
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-min-64-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-min-64-chars
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@vendora.co.uk
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SUMUP_API_KEY=
ZETTLE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_URL=https://api.truelayer.com
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=10
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173
ENABLE_OPEN_BANKING=false
ENABLE_WALLET_PASSES=false
ENABLE_ACCOUNTING_SYNC=false

# WhatsApp for the nightly "shop closed fine" owner summary (Twilio).
# Leave blank to disable — the summary is then recorded as "skipped", never sent.
# TWILIO_WHATSAPP_FROM is your Twilio WhatsApp sender, e.g. whatsapp:+14155238886
# (the Twilio sandbox number works for testing once you join the sandbox).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ─────────────────────────────────────────────────────────────────────────────
# Product pictures (CORE feature; not the paid add-on)
# Owner photos are kept on-device and work offline regardless of these. When ON, photos are also backed up
# cross-device to GridFS — i.e. inside MongoDB/Atlas (DURABLE), never the ephemeral Render disk. OFF by default.
PRODUCT_IMAGES=false
PRODUCT_IMAGES_PROVIDER=gridfs
PRODUCT_IMAGE_MAX_MB=5

# ─────────────────────────────────────────────────────────────────────────────
# Neighbourhood Insights (OPTIONAL PAID ADD-ON) — all OFF by default; the core PWA works without any of this.
# 1) Mount the routes at all:
INSIGHTS_ENABLED=false
# 2) Census DATA provider (England & Wales, ONS Census 2021 via Nomis, OGL v3.0). Blank = not configured:
#    the app then shows "not set up yet" and NEVER fabricates numbers.
INSIGHTS_DATA_PROVIDER=
#    OA (2021) population-weighted centroids file — download from the ONS Open Geography Portal (see
#    obsidian-vault/Deployment-Config.md). CSV (OA21CD,lat,long) or NDJSON. Required for real profiles.
INSIGHTS_CENTROIDS_PATH=
NOMIS_API_BASE=https://www.nomisweb.co.uk/api/v01
#    Optional JSON overriding the Nomis dataset-id / dimension map (verify with scripts/verify-insights.js):
INSIGHTS_NOMIS_TABLES_PATH=
INSIGHTS_CACHE_TTL=86400
INSIGHTS_FETCH_TIMEOUT_MS=15000
INSIGHTS_MAX_OA=2000
# 3) Location provider (postcode → point; open data, OGL v3.0):
INSIGHTS_LOCATION_PROVIDER=postcodes_io
POSTCODES_IO_BASE=https://api.postcodes.io

# ─────────────────────────────────────────────────────────────────────────────
# Billing for the PWA (Stripe) — SEPARATE from the deferred till subscription. Nothing charges live.
# Provider switch ('stripe' or blank):
INSIGHTS_BILLING_PROVIDER=
# Use a TEST key for STRIPE_SECRET_KEY above (sk_test_…). A live key (sk_live_…) is REFUSED unless:
BILLING_ALLOW_LIVE=false
# This endpoint's OWN webhook signing secret (whsec_… from the Stripe dashboard; NOT the till's secret):
INSIGHTS_STRIPE_WEBHOOK_SECRET=
# What (if anything) is on sale: off | one_off | subscription.
# A recurring 'subscription' sale is only offered once INSIGHTS_DATA_PROVIDER is configured; otherwise it
# falls back to a one-off report (if INSIGHTS_STRIPE_PRICE_ONEOFF is set) or to off.
INSIGHTS_SALE_MODE=off
# TEST-mode price ids you create in Stripe (proposed: £19/mo core, £5/mo add-on, one-off report):
INSIGHTS_STRIPE_PRICE_CORE=
INSIGHTS_STRIPE_PRICE_ADDON=
INSIGHTS_STRIPE_PRICE_ONEOFF=
INSIGHTS_PRICE_CURRENCY=GBP
INSIGHTS_REPORT_VALID_DAYS=30
INSIGHTS_BILLING_SUCCESS_URL=
INSIGHTS_BILLING_CANCEL_URL=
# Optional generic (non-Stripe) normalised-webhook shared secret, for manual grants / other providers:
INSIGHTS_BILLING_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Real neighbourhood area data (postcodes.io → ONS Beta API / Nomis, cached). OFF by default.
# The browser never calls these upstreams directly — only the backend does.
NEIGHBOURHOOD_ENABLED=false
NEIGHBOURHOOD_SOURCE=ons                 # 'ons' (api.beta.ons.gov.uk) or 'nomis'
# Descriptive User-Agent ONS asks for (botName/version (organisation contact-email +url)) — no personal data:
ONS_USER_AGENT=vendora/1.0.0 (ops@yourdomain +https://claude-ai-indol.vercel.app)
# Optional Nomis Unique ID — SECRET, removes the 25k-cell guest limit. Never commit a real value:
NOMIS_UID=
# Dataset id for the population figure. Leave blank until confirmed from the live catalogue
# (ONS /datasets or Nomis /api/v01/dataset/def.sdmx.json). We do NOT hardcode an unverified id.
NEIGHBOURHOOD_POP_DATASET=
NEIGHBOURHOOD_TTL_HOURS=168              # re-fetch when the cached record is older than this (7 days)
NEIGHBOURHOOD_TIMEOUT_MS=55000          # tolerate a ~50s Render cold start
NEIGHBOURHOOD_MAX_CONCURRENT=2
NEIGHBOURHOOD_STALE_MAX_DAYS=400        # beyond this a stored figure is shown as "out of date"
